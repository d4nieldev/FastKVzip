# The repo root ignores *.json outright, which would swallow package.json and
# the tsconfigs. Re-include them here, then ignore build and runtime output.
!*.json

# Holds the ingest token for a checkout-local deployment.
.dashboard-env

.venv/
node_modules/
web/dist/
*.tsbuildinfo
server/static/
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
