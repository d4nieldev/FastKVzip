# Copy to ~/.fastkvzip-dashboard/env on the cluster and chmod 600.
# Sourced by dashboard_agent.sbatch; never passed via --export, because
# anything in --export is visible to every user through scontrol show job.

DASHBOARD_URL=https://your-app.example.com
DASHBOARD_TOKEN=replace-with-the-same-value-as-the-servers-DASHBOARD_TOKEN

# Optional overrides.
# DASHBOARD_POLL_INTERVAL=30
# DASHBOARD_USER=danieloh
